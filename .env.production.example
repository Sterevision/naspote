# ==========================================================
#  КАРТОМЕТР — production environment
#  Скопируйте в .env и заполните реальными значениями
# ==========================================================

# Supabase (обязательно)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Flask (обязательно)
# Сгенерируйте: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-very-long-random-secret-key-at-least-32-bytes

# Окружение
FLASK_ENV=production
FLASK_DEBUG=0

# Сервер
PORT=8000
BEHIND_PROXY=1

# Безопасность сессий
SESSION_COOKIE_SECURE=auto

# CSRF
CSRF_STRICT=auto

# Rate limiting
RATE_LIMITS_ENABLED=1

# Логирование (опционально)
LOG_LEVEL=INFO
LOG_FILE=/var/www/kartometr/logs/app.log